# ==========================================
# CryptoRadar - Çevre Değişkenleri Şablonu (.env.example) 
# Bu dosyadaki değerler temsili olup gerçek API anahtarı veya kimlik bilgisi içermez.
# Projeyi çalıştırmadan önce kendi bilgilerinizle değiştiriniz.
# ==========================================

# --- Yapay Zekâ / AI Servisleri ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- Telegram Entegrasyonu ---
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Webhook Ayarları ---
WEBHOOK_SECRET=your_webhook_secret_here

# --- Veritabanı (Database) Yapılandırması ---
DATABASE_PASSWORD=your_database_password
DATABASE_CONNECTION_URI=postgresql://kullanici:sifre@localhost:5432/cryptoradar
