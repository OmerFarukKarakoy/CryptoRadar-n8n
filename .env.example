# ==========================================
# CryptoRadar - Çevre Değişkenleri Şablonu (.env.example) 
# (Veriler doğru değil bu dosya sadece kullanıcılar için örnek kılavuz amacıyla oluşturuldu)
# ==========================================

# --- Yapay Zekâ / AI Servisleri ---
GEMINI_API_KEY=AIzaSy...

# --- Telegram Entegrasyonu ---
TELEGRAM_CHAT_ID=123456789
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# --- Webhook Ayarları ---
WEBHOOK_SECRET=your_webhook_secret_here

# --- Borsa / Kripto API Anahtarları ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET_KEY=your_binance_secret_key_here

# --- Diğer Servis API Anahtarları ---
OTHER_SERVICE_API_KEY=

# --- Veritabanı (Database) Yapılandırması ---
DATABASE_PASSWORD=your_database_password
DATABASE_CONNECTION_URI=postgresql://kullanici:sifre@localhost:5432/cryptoradar

# --- Güvenlik & Yetkilendirme (Auth) ---
JWT_SECRET=your_jwt_secret_key
OAUTH_CLIENT_SECRET=your_oauth_client_secret

# --- E-posta / SMTP Yapılandırması ---
SMTP_PASSWORD=your_smtp_password

